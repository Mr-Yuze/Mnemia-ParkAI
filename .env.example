# Mnemia ParkAI - Environment Configuration Template
# To connect Google Firebase Cloud Firestore, provide your Firebase Web App configuration credentials below.
# If left empty, Mnemia ParkAI operates in high-performance local persistent reactive mode with full pre-seeded college demo data.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional Payment Gateway Configuration (For Production Integration)
VITE_RAZORPAY_KEY_ID=
VITE_PAYMENT_MODE=demo
